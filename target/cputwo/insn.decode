#
# CPUTwo instruction decode definitions.
#
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Fixed 32-bit instruction width, opcode in bits [31:24].
#
# Formats:
#   R-type: opcode[31:24] rd[23:20] rs1[19:16] rs2[15:12] shift[11:7] func[6:0]
#   I-type: opcode[31:24] rd[23:20] rs1[19:16] imm16[15:0]
#   B-type: opcode[31:24] cond[23:20] offset20[19:0]
#   M-type: opcode[31:24] rd[23:20] rs1[19:16] imm16[15:0]  (same as I-type)
#   J-type: opcode[31:24] rd[23:20] offset20[19:0]

# Argument sets
&r       rd rs1 rs2 shift
&i       rd rs1 imm16
&b       cond offset20
&j       rd offset20

# Formats
# R-type with shift field
@r       ........ rd:4 rs1:4 rs2:4 shift:5 -------     &r
# R-type without shift (shift=0, ignore lower 12 bits)
@r_nosh  ........ rd:4 rs1:4 rs2:4 ----- -------       &r shift=0
# I-type with signed imm16
@i       ........ rd:4 rs1:4 imm16:s16                  &i
# I-type with unsigned imm16
@iu      ........ rd:4 rs1:4 imm16:16                   &i
# B-type
@b       ........ cond:4 offset20:s20                    &b
# J-type
@j       ........ rd:4 offset20:s20                      &j
# M-type is same encoding as I-type (signed offset)
@m       ........ rd:4 rs1:4 imm16:s16                  &i

# R-type ALU instructions
ADD      00000000 .... .... .... ----- -------          @r_nosh
SUB      00000001 .... .... .... ----- -------          @r_nosh
AND      00000010 .... .... .... ----- -------          @r_nosh
OR       00000011 .... .... .... ----- -------          @r_nosh
XOR      00000100 .... .... .... ----- -------          @r_nosh
NOT      00000101 .... .... .... ----- -------          @r_nosh
LSL      00000110 .... .... .... ..... -------          @r
LSR      00000111 .... .... .... ..... -------          @r
ASR      00001000 .... .... .... ..... -------          @r
MUL      00001001 .... .... .... ----- -------          @r_nosh
DIV      00001010 .... .... .... ----- -------          @r_nosh
# Memory (M-type)
LW       00001011 .... .... ................            @m
SW       00001100 .... .... ................            @m
# Branch (B-type)
Bcc      00001101 .... ....................             @b
# Jump (J-type)
JMP      00001110 .... ....................             @j
# I-type immediate
MOVI     00001111 .... .... ................            @iu
SYSCALL  00010000 ---- ---- ---- ----- -------
SYSRET   00010001 ---- ---- ---- ----- -------
HALT     00010010 ---- ---- ---- ----- -------
MOVHI    00010011 .... .... ................            @iu
ADDI     00010100 .... .... ................            @i
SUBI     00010101 .... .... ................            @i
ANDI     00010110 .... .... ................            @iu
ORI      00010111 .... .... ................            @iu
XORI     00011000 .... .... ................            @iu
LSLI     00011001 .... .... ................            @iu
LSRI     00011010 .... .... ................            @iu
ASRI     00011011 .... .... ................            @iu
# Sub-word loads/stores (M-type)
LH       00011100 .... .... ................            @m
LHU      00011101 .... .... ................            @m
LB       00011110 .... .... ................            @m
LBU      00011111 .... .... ................            @m
SH       00100000 .... .... ................            @m
SB       00100001 .... .... ................            @m
# More R-type
MULH     00100010 .... .... .... ----- -------          @r_nosh
MULHU    00100011 .... .... .... ----- -------          @r_nosh
DIVU     00100100 .... .... .... ----- -------          @r_nosh
MOD      00100101 .... .... .... ----- -------          @r_nosh
MODU     00100110 .... .... .... ----- -------          @r_nosh
MOV      00100111 .... .... .... ----- -------          @r_nosh
CMP      00101000 .... .... .... ----- -------          @r_nosh
CMPI     00101001 .... .... ................            @iu
CALLR    00101010 .... .... .... ----- -------          @r_nosh
ADDC     00101011 .... .... .... ----- -------          @r_nosh
SUBC     00101100 .... .... .... ----- -------          @r_nosh
LSLR     00101101 .... .... .... ----- -------          @r_nosh
LSRR     00101110 .... .... .... ----- -------          @r_nosh
ASRR     00101111 .... .... .... ----- -------          @r_nosh
# Indexed memory (R-type encoding)
LWX      00110000 .... .... .... ----- -------          @r_nosh
LBX      00110001 .... .... .... ----- -------          @r_nosh
LBUX     00110010 .... .... .... ----- -------          @r_nosh
SWX      00110011 .... .... .... ----- -------          @r_nosh
SBX      00110100 .... .... .... ----- -------          @r_nosh
LHX      00110101 .... .... .... ----- -------          @r_nosh
LHUX     00110110 .... .... .... ----- -------          @r_nosh
SHX      00110111 .... .... .... ----- -------          @r_nosh
LUI      00111000 .... .... ................            @iu
# Rotates
ROLR     00111001 .... .... .... ----- -------          @r_nosh
RORR     00111010 .... .... .... ----- -------          @r_nosh
ROLI     00111011 .... .... .... ..... -------          @r
RORI     00111100 .... .... .... ..... -------          @r
# CAS
CAS      00111101 .... .... .... ----- -------          @r_nosh
# SFENCE / KRET
SFENCE   00111110 ---- ---- ---- ----- -------
KRET     00111111 ---- ---- ---- ----- -------
